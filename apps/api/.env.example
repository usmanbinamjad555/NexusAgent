# Express API Environment Variables
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://nexus_user:nexus_secret_password@localhost:5432/nexus_agent?schema=public
REDIS_URL=redis://:nexus_redis_password@localhost:6379


# Agents: leave ANTHROPIC_API_KEY empty to use the offline mock provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PERSIST_RUNS=false
