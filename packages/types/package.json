{
  "name": "@nexus-agent/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript domain models and API contracts for NexusAgent",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nexus-agent/tsconfig": "*",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
