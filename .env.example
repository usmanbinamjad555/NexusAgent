# ==============================================
# NexusAgent - Global Environment Configuration
# ==============================================

# Database (PostgreSQL)
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus_secret_password
POSTGRES_DB=nexus_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexus_user:nexus_secret_password@localhost:5432/nexus_agent?schema=public

# Cache & Message Broker (Redis)
REDIS_PASSWORD=nexus_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:nexus_redis_password@localhost:6379

# Express API Backend
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development

